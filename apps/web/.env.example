# Copy to apps/web/.env.local

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""  # legacy anon key if needed

# Local Docker Postgres (docker compose up -d from repo root)
DATABASE_URL="postgresql://domchat:domchat@localhost:5432/domchat"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis + realtime (Phase 2)
REDIS_URL="redis://localhost:6379"
WS_PORT=4001
NEXT_PUBLIC_WS_URL="ws://localhost:4001"
# Local only: allow `verify:<userId>` WS tokens for scripts/verify-phase2.mts (never in production)
# ALLOW_VERIFY_WS_TOKENS=1

# LLM (Phase 0 spike)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
