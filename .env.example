# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://domchat:domchat@localhost:5432/domchat"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# LLM provider (Phase 0 spike / Phase 3 agent — pick one)
OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# GitHub (Phase 3 public repo tools; optional, recommended for code search)
# GITHUB_TOKEN=""

# Supabase Auth (Phase 1+)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Realtime + agent worker (Phase 2–3) — `npm run dev` in apps/web starts web, realtime, and worker
WS_PORT=4001
NEXT_PUBLIC_WS_URL="ws://localhost:4001"
