{
  "name": "domchat-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-ws-port.mjs",
    "dev": "concurrently -n web,realtime,worker -c cyan,magenta,green \"next dev\" \"npm run dev:realtime\" \"npm run dev:worker\"",
    "dev:web": "next dev",
    "dev:realtime": "tsx src/realtime/server.ts",
    "dev:worker": "tsx src/worker/agent-runner.ts",
    "dev:all": "npm run dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:realtime": "tsx src/realtime/server.ts",
    "start:worker": "tsx src/worker/agent-runner.ts",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "bullmq": "^6.2.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
